# ---------------------------------------------------------------------------
# Copy to .env.local for local development, and set the same keys in Vercel
# (Production + Preview). Every value here is optional: with none of them set
# the app builds and runs, analytics and ads simply render nothing.
#
# All keys are NEXT_PUBLIC_* because they are read in the browser. Do not put
# anything secret in this file.
# ---------------------------------------------------------------------------

# Document-conversion backend (FastAPI service on Railway).
# Replaces the old Vite-era VITE_API_URL. Only the Office-format conversions
# (PDF <-> Word/Excel/PowerPoint) call it; everything else runs in the browser.
# Falls back to http://localhost:8000/api when unset.
NEXT_PUBLIC_API_URL=https://your-railway-service.up.railway.app/api

# Canonical origin used for canonicals, hreflang, sitemap and JSON-LD.
# Defaults to https://imagecompressor.cloud when unset.
NEXT_PUBLIC_SITE_URL=https://imagecompressor.cloud

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Unset -> no gtag script is rendered at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456.
# Unset -> no adsbygoogle script is rendered; the <AdBanner> placeholders
# still render their empty reserved slots.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Search Console HTML-tag verification token (the content="..." value).
# Unset -> no google-site-verification meta tag is emitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
