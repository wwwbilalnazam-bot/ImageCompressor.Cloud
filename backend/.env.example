# Comma-separated list of origins allowed to call this API. MUST include
# your deployed frontend's real production domain (e.g. https://imagecompressor.cloud)
# or the browser will block every request with a CORS error.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://imagecompressor.cloud

# Max upload size in MB. LibreOffice/pdf2docx conversions are memory-heavy,
# so keep this conservative unless your host has generous RAM.
MAX_FILE_SIZE_MB=50

# Hard timeout (seconds) per conversion request, so one pathological file
# can't hang a worker indefinitely.
CONVERSION_TIMEOUT_SECONDS=150

# Only needed if LibreOffice isn't on PATH as "soffice" (e.g. a custom
# install location). Leave unset on Railway/Docker deployments.
# LIBREOFFICE_PATH=/usr/bin/soffice
